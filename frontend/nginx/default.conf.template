# Rendered at container start by the nginx image's entrypoint (envsubst). Only variables that exist
# in the environment are substituted, so nginx's own $variables are left alone.
#   ${API_UPSTREAM}              backend base URL, e.g. http://backend:8000
#   ${APP_ENV}                   environment label for the UI
#   ${DASHBOARD_REFRESH_SECONDS} live dashboard polling interval
#   ${NGINX_LOCAL_RESOLVERS}     DNS servers from /etc/resolv.conf (set by the entrypoint)

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Resolve the backend name per request (valid 10 s) instead of once at startup, so a restarted
    # backend container with a new IP is picked up and nginx starts even before the backend exists.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    include /etc/nginx/snippets/security-headers.conf;

    # Container liveness/readiness for Docker and Kubernetes. Never proxied.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime configuration, generated from the environment at start: build once, deploy anywhere.
    location = /config.js {
        default_type application/javascript;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 'window.__CIVICPULSE_CONFIG__ = Object.freeze({"environment":"${APP_ENV}","refreshSeconds":"${DASHBOARD_REFRESH_SECONDS}"});\n';
    }

    # Same-origin API: the browser calls /api/..., nginx forwards it unchanged. No CORS, no backend URL
    # in the bundle. (On Kubernetes the Ingress routes /api to the backend before it reaches us.)
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $cp_request_id;
        # The backend's per-IP rate limiter must key on these, not on nginx's address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # AI triage: 10 s per LLM call + one retry + fallback, so allow well beyond 20 s.
        proxy_read_timeout 60s;
        client_max_body_size 64k;
    }

    # Content-hashed bundles: cache forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes (/dashboard, /stats, /complaints/:id) all serve the SPA shell.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
