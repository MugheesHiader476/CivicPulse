{
  "openapi": "3.1.0",
  "info": {
    "title": "CivicPulse API",
    "version": "0.1.0",
    "description": "Snapshot of the backend contract (assignment section 2.2). Regenerate from the running backend with: curl -s http://<backend>/openapi.json -o openapi/openapi.json && npm run gen:api"
  },
  "paths": {
    "/api/complaints": {
      "post": {
        "tags": ["complaints"],
        "summary": "Submit a complaint",
        "description": "Validate, triage, persist. Rate limited per client IP.",
        "operationId": "create_complaint",
        "parameters": [
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ComplaintCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created and triaged",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Complaint" }
              }
            }
          },
          "400": {
            "description": "Field-level validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the caller may submit again",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["complaints"],
        "summary": "List complaints",
        "operationId": "list_complaints",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "$ref": "#/components/schemas/Category" }, { "type": "null" }] }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "$ref": "#/components/schemas/Priority" }, { "type": "null" }] }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "$ref": "#/components/schemas/Status" }, { "type": "null" }] }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "One page of complaints, newest first",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ComplaintPage" }
              }
            }
          },
          "400": {
            "description": "Invalid filter or pagination parameter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/complaints/{id}": {
      "get": {
        "tags": ["complaints"],
        "summary": "Get one complaint",
        "operationId": "get_complaint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "The complaint",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Complaint" }
              }
            }
          },
          "404": {
            "description": "No complaint with this id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/complaints/{id}/status": {
      "patch": {
        "tags": ["complaints"],
        "summary": "Advance a complaint's status",
        "description": "The server enforces the status state machine. An invalid transition returns 409 with a detail naming the attempted transition.",
        "operationId": "update_status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StatusUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated complaint",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Complaint" }
              }
            }
          },
          "404": {
            "description": "No complaint with this id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Invalid status transition",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["stats"],
        "summary": "Aggregate counts",
        "description": "Read-through Redis cache, TTL 30 s, invalidated on write.",
        "operationId": "get_stats",
        "parameters": [
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "Counts by category, priority and status",
            "headers": {
              "X-Cache": {
                "description": "Whether the response was served from the Redis cache",
                "schema": { "type": "string", "enum": ["HIT", "MISS"] }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          }
        }
      }
    },
    "/api/meta/providers": {
      "get": {
        "tags": ["meta"],
        "summary": "Triage provider observability",
        "description": "The active triage provider and the last 20 triage outcomes.",
        "operationId": "get_providers",
        "parameters": [
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "Provider status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProvidersMeta" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["ops"],
        "summary": "Liveness - never touches the database",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["ops"],
        "summary": "Readiness - Postgres and Redis reachable",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "All dependencies reachable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Readiness" }
              }
            }
          },
          "503": {
            "description": "A dependency is unreachable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Readiness" }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["ops"],
        "summary": "Prometheus metrics",
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition format",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Correlation id, propagated into every backend log line. Generated server-side when absent.",
        "schema": { "type": "string", "maxLength": 128 }
      }
    },
    "schemas": {
      "Category": {
        "type": "string",
        "enum": ["water", "electricity", "sanitation", "roads", "streetlights", "other"],
        "title": "Category"
      },
      "Priority": {
        "type": "string",
        "enum": ["high", "normal", "low"],
        "title": "Priority"
      },
      "Status": {
        "type": "string",
        "enum": ["open", "in_progress", "resolved", "rejected"],
        "title": "Status"
      },
      "ComplaintCreate": {
        "type": "object",
        "title": "ComplaintCreate",
        "required": ["text", "location"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000,
            "title": "Text",
            "description": "Free-text complaint"
          },
          "location": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "title": "Location"
          },
          "reporter_contact": {
            "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }],
            "title": "Reporter Contact",
            "default": null
          }
        }
      },
      "Complaint": {
        "type": "object",
        "title": "Complaint",
        "required": [
          "id",
          "text",
          "location",
          "reporter_contact",
          "category",
          "priority",
          "status",
          "ai_summary",
          "triaged_by",
          "triage_latency_ms",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "text": { "type": "string", "title": "Text" },
          "location": { "type": "string", "title": "Location" },
          "reporter_contact": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Reporter Contact"
          },
          "category": { "$ref": "#/components/schemas/Category" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "status": { "$ref": "#/components/schemas/Status" },
          "ai_summary": {
            "anyOf": [{ "type": "string", "maxLength": 140 }, { "type": "null" }],
            "title": "Ai Summary"
          },
          "triaged_by": {
            "type": "string",
            "title": "Triaged By",
            "description": "Which provider produced the triage: llm:groq, llm:ollama, rules or rules:fallback",
            "examples": ["llm:groq", "llm:ollama", "rules", "rules:fallback"]
          },
          "triage_latency_ms": {
            "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
            "title": "Triage Latency Ms"
          },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" },
          "updated_at": { "type": "string", "format": "date-time", "title": "Updated At" }
        }
      },
      "ComplaintPage": {
        "type": "object",
        "title": "ComplaintPage",
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Complaint" },
            "title": "Items"
          },
          "total": { "type": "integer", "minimum": 0, "title": "Total" },
          "page": { "type": "integer", "minimum": 1, "title": "Page" },
          "page_size": { "type": "integer", "minimum": 1, "maximum": 100, "title": "Page Size" }
        }
      },
      "StatusUpdate": {
        "type": "object",
        "title": "StatusUpdate",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/Status" }
        }
      },
      "Stats": {
        "type": "object",
        "title": "Stats",
        "required": ["total", "by_category", "by_priority", "by_status"],
        "properties": {
          "total": { "type": "integer", "minimum": 0, "title": "Total" },
          "by_category": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "title": "By Category"
          },
          "by_priority": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "title": "By Priority"
          },
          "by_status": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "title": "By Status"
          }
        }
      },
      "TriageOutcome": {
        "type": "object",
        "title": "TriageOutcome",
        "required": ["complaint_id", "provider", "latency_ms", "fallback", "created_at"],
        "properties": {
          "complaint_id": {
            "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }],
            "title": "Complaint Id"
          },
          "provider": { "type": "string", "title": "Provider" },
          "latency_ms": { "type": "integer", "minimum": 0, "title": "Latency Ms" },
          "fallback": { "type": "boolean", "title": "Fallback" },
          "error_class": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error Class",
            "default": null
          },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        }
      },
      "ProvidersMeta": {
        "type": "object",
        "title": "ProvidersMeta",
        "required": ["active_provider", "recent"],
        "properties": {
          "active_provider": {
            "type": "string",
            "title": "Active Provider",
            "description": "Provider selected by TRIAGE_PROVIDER, e.g. llm:groq"
          },
          "recent": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/TriageOutcome" },
            "title": "Recent",
            "description": "The last 20 triage outcomes, newest first"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "title": "FieldError",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string", "title": "Field" },
          "message": { "type": "string", "title": "Message" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "title": "ValidationErrorResponse",
        "required": ["detail", "errors"],
        "properties": {
          "detail": { "type": "string", "title": "Detail" },
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "title": "Errors"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "title": "ErrorResponse",
        "required": ["detail"],
        "properties": {
          "detail": { "type": "string", "title": "Detail" }
        }
      },
      "Health": {
        "type": "object",
        "title": "Health",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "title": "Status" }
        }
      },
      "Readiness": {
        "type": "object",
        "title": "Readiness",
        "required": ["status", "checks"],
        "properties": {
          "status": { "type": "string", "title": "Status" },
          "checks": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "title": "Checks"
          }
        }
      }
    }
  }
}
